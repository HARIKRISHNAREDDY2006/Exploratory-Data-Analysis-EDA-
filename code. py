# ==========================================
# TASK 2: Exploratory Data Analysis (EDA)
# ==========================================

# Import Libraries
import os
import pandas as pd
import numpy as np
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import seaborn as sns

from scipy.stats import ttest_ind

# Display settings
pd.set_option('display.max_columns', None)

plot_dir = "plots"
os.makedirs(plot_dir, exist_ok=True)

def save_plot(name):
    path = os.path.join(plot_dir, name)
    plt.tight_layout()
    plt.savefig(path)
    plt.close()

# ==========================================
# 1. LOAD DATASET
# ==========================================

if not os.path.exists("data.csv"):
    raise FileNotFoundError("Dataset file 'data.csv' not found in the workspace.")

date_cols = []
with open("data.csv", "r", encoding="utf-8") as f:
    header = f.readline().strip().split(',')
    date_cols = [col for col in header if "date" in col.lower()]

df = pd.read_csv("data.csv", parse_dates=date_cols)
print("Dataset Loaded Successfully\n")

# ==========================================
# 2. ASK MEANINGFUL QUESTIONS
# ==========================================

print("""
Business Questions:

1. How many records are present?
2. Which columns contain missing values?
3. What are the data types of each variable?
4. Are there any duplicate records?
5. Which variables have the highest values?
6. Are there any trends or patterns?
7. Are there outliers in numerical columns?
8. Which variables are strongly correlated?
9. Are there significant differences between groups?
10. What data quality issues exist?
""")

# ==========================================
# 3. EXPLORE DATA STRUCTURE
# ==========================================

print("\nFIRST 5 ROWS")
print(df.head())

print("\nLAST 5 ROWS")
print(df.tail())

print("\nDATASET SHAPE")
print(df.shape)

print("\nCOLUMN NAMES")
print(df.columns)

print("\nDATA TYPES")
print(df.dtypes)

print("\nINFO")
print(df.info())

# ==========================================
# 4. SUMMARY STATISTICS
# ==========================================

print("\nNUMERICAL SUMMARY")
print(df.describe())

print("\nCATEGORICAL SUMMARY")
print(df.describe(include=['object', 'string']))

# ==========================================
# 5. MISSING VALUES
# ==========================================

print("\nMISSING VALUES")
print(df.isnull().sum())

plt.figure(figsize=(10,5))
sns.heatmap(df.isnull(), cbar=False)
plt.title("Missing Values Heatmap")
save_plot("missing_values_heatmap.png")

# ==========================================
# 6. DUPLICATE RECORDS
# ==========================================

duplicates = df.duplicated().sum()
print("\nDuplicate Rows:", duplicates)

# ==========================================
# 7. UNIVARIATE ANALYSIS
# ==========================================

numeric_cols = df.select_dtypes(include=np.number).columns

if len(numeric_cols) > 0:
    for col in numeric_cols:
        plt.figure(figsize=(12,4))

        plt.subplot(1,2,1)
        sns.histplot(df[col].dropna(), kde=True)
        plt.title(f"Histogram - {col}")

        plt.subplot(1,2,2)
        sns.boxplot(x=df[col].dropna())
        plt.title(f"Boxplot - {col}")

        save_plot(f"univariate_{col}.png")
else:
    print("No numerical columns available for univariate analysis.")

# ==========================================
# 8. CATEGORICAL ANALYSIS
# ==========================================

categorical_cols = df.select_dtypes(include=['object', 'string']).columns

if len(categorical_cols) > 0:
    for col in categorical_cols:
        plt.figure(figsize=(8,4))
        sns.countplot(data=df, x=col, order=df[col].value_counts().index)
        plt.title(f"Count Plot - {col}")
        save_plot(f"countplot_{col}.png")
else:
    print("No categorical columns available for categorical analysis.")

# ==========================================
# 9. CORRELATION ANALYSIS
# ==========================================

if len(numeric_cols) > 1:
    corr_matrix = df[numeric_cols].corr()
    plt.figure(figsize=(10,8))
    sns.heatmap(corr_matrix, annot=True, cmap='coolwarm')
    plt.title("Correlation Matrix")
    save_plot("correlation_matrix.png")
else:
    print("Not enough numerical columns available for correlation analysis.")

# ==========================================
# 10. DETECT OUTLIERS
# ==========================================

print("\nOUTLIER DETECTION")
for col in numeric_cols:
    Q1 = df[col].quantile(0.25)
    Q3 = df[col].quantile(0.75)
    IQR = Q3 - Q1
    lower = Q1 - 1.5 * IQR
    upper = Q3 + 1.5 * IQR
    outliers = df[(df[col] < lower) | (df[col] > upper)]
    print(f"{col}: {len(outliers)} outliers")

# ==========================================
# 11. TREND ANALYSIS
# ==========================================

date_columns = df.select_dtypes(include=['datetime64[ns]', 'datetime64']).columns

if len(date_columns) > 0 and len(numeric_cols) > 0:
    date_col = date_columns[0]
    target_col = numeric_cols[0]
    trend = df.groupby(date_col)[target_col].mean()
    plt.figure(figsize=(10,5))
    trend.plot()
    plt.title("Trend Analysis")
    plt.xlabel(date_col)
    plt.ylabel(target_col)
    save_plot("trend_analysis.png")
else:
    if len(date_columns) == 0:
        print("No datetime columns available for trend analysis.")
    if len(numeric_cols) == 0:
        print("No numerical columns available for trend analysis.")

# ==========================================
# 12. HYPOTHESIS TESTING
# ==========================================

if len(categorical_cols) > 0 and len(numeric_cols) > 0:
    cat_col = categorical_cols[0]
    num_col = numeric_cols[0]
    groups = df[cat_col].dropna().unique()

    if len(groups) >= 2:
        group1 = df[df[cat_col] == groups[0]][num_col]
        group2 = df[df[cat_col] == groups[1]][num_col]
        t_stat, p_value = ttest_ind(group1, group2, nan_policy='omit')

        print("\nHYPOTHESIS TESTING")
        print("Group 1:", groups[0])
        print("Group 2:", groups[1])
        print("T-Statistic:", t_stat)
        print("P-Value:", p_value)

        if p_value < 0.05:
            print("Significant Difference Found")
        else:
            print("No Significant Difference Found")
    else:
        print("Not enough groups available for hypothesis testing.")
else:
    print("Not enough categorical or numerical columns available for hypothesis testing.")

# ==========================================
# 13. DATA QUALITY CHECKS
# ==========================================

print("\nDATA QUALITY REPORT")
print("Missing Values:")
print(df.isnull().sum())

print("\nDuplicate Rows:")
print(df.duplicated().sum())

print("\nData Types:")
print(df.dtypes)

